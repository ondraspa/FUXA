{
  "_meta": {
    "title": "FUXA SCADA Widget Database",
    "version": "1.0.0",
    "standards": [
      "ISA-5.1-2022",
      "ISA-101-2015"
    ],
    "description": "Complete widget registry compliant with ISA-5.1 instrumentation symbols and ISA-101 high-performance HMI guidelines."
  },
  "categories": {
    "instruments": {
      "isa101_palette": {
        "background": "#e8e8e8",
        "normal": "#f0f0f0",
        "running": "#4caf50",
        "stopped": "#f44336",
        "warning": "#ff9800",
        "info": "#2196f3",
        "text": "#212121",
        "disabled": "#9e9e9e"
      },
      "widgets": {
        "pressure-transmitter": {
          "isa51_tag": "PIT",
          "isa51_meaning": "Pressure Indicator Transmitter",
          "variables": {
            "_pn_pressure": {
              "unit": "bar",
              "type": "number",
              "range": "0-400"
            },
            "_pb_alarm": {
              "type": "boolean"
            }
          },
          "connection_ports": [
            {
              "id": "process",
              "direction": "left",
              "type": "impulse_line"
            }
          ],
          "animations": {
            "alarm": {
              "type": "flash",
              "color": "#f44336"
            }
          },
          "isa101_display": "exception",
          "description": "Gauge with circular dial showing process pressure. Gray background, red alarm flash."
        },
        "flow-transmitter": {
          "isa51_tag": "FIT",
          "isa51_meaning": "Flow Indicator Transmitter",
          "variables": {
            "_pn_flow": {
              "unit": "m\u00b3/h",
              "type": "number",
              "range": "0-1000"
            },
            "_pb_alarm": {
              "type": "boolean"
            }
          },
          "animations": {
            "flow_line": {
              "type": "dashed_march",
              "color": "#616161"
            }
          },
          "description": "Orifice plate with differential pressure lines to transmitter."
        },
        "level-transmitter": {
          "isa51_tag": "LIT",
          "isa51_meaning": "Level Indicator Transmitter",
          "variables": {
            "_pn_level": {
              "unit": "%",
              "type": "number",
              "range": "0-100"
            },
            "_pb_alarm": {
              "type": "boolean"
            }
          },
          "animations": {
            "level_fill": {
              "type": "fill",
              "color": "#90caf9"
            }
          },
          "description": "Vessel with level measuring element and transmitter head."
        },
        "temperature-transmitter": {
          "isa51_tag": "TIT",
          "isa51_meaning": "Temperature Indicator Transmitter",
          "variables": {
            "_pn_temp": {
              "unit": "\u00b0C",
              "type": "number",
              "range": "-50-500"
            },
            "_pb_alarm": {
              "type": "boolean"
            }
          },
          "connection_ports": [
            {
              "id": "thermowell",
              "direction": "left",
              "type": "process"
            }
          ],
          "description": "Thermowell with connection head and transmitter."
        },
        "analytical-transmitter": {
          "isa51_tag": "AIT",
          "isa51_meaning": "Analysis Indicator Transmitter",
          "variables": {
            "_pn_ph": {
              "unit": "pH",
              "type": "number",
              "range": "0-14"
